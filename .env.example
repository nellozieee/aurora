# =============================================================================
# AURORA CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values you need.
# Any provider left unconfigured will report as UNAVAILABLE instead of
# crashing the application.
# =============================================================================

# ----- APPLICATION -----------------------------------------------------------
APP_NAME=Aurora
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=
APP_TIMEZONE=
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- DATABASE ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# ----- REDIS --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- AI -------------------------------------------------------------------
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_PROVIDER=

# ----- OPENAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----- OPENROUTER -------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# ----- OLLAMA -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ----- VOICE ------------------------------------------------------------------
# Safe default: off until you opt in, even though local STT/TTS need no keys.
VOICE_ENABLED=false
VOICE_MODE=disabled
WAKE_WORD=Hey Aurora
# Where local Whisper model files are downloaded/cached
VOICE_MODELS_DIR=./models

# ----- STT ----------------------------------------------------------------
# local = faster-whisper (no API key, downloads a small model on first use)
# openai = OpenAI's hosted transcription API (requires OPENAI_API_KEY)
STT_PROVIDER=local
STT_MODEL=tiny.en

# ----- TTS ----------------------------------------------------------------
# local = pyttsx3 (Windows SAPI5 / OS-native voices, no API key)
# openai = OpenAI's hosted TTS API (requires OPENAI_API_KEY)
TTS_PROVIDER=local
TTS_VOICE=
TTS_SPEED=1.0

# ----- VISION -----------------------------------------------------------
# Screen capture is always local; this only picks which AI provider/model
# analyzes the resulting image (must be a vision-capable model).
VISION_PROVIDER=ollama
VISION_MODEL=moondream

# ----- TELEGRAM -----------------------------------------------------------
# Optional. To set up: message @BotFather on Telegram, /newbot, copy the
# token it gives you into TELEGRAM_BOT_TOKEN. Then message your new bot once
# and fetch https://api.telegram.org/bot<TOKEN>/getUpdates to find your
# chat id (message.chat.id in the response) for TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- WEB ------------------------------------------------------------------
WEB_SEARCH_PROVIDER=
WEB_REQUEST_TIMEOUT_SECONDS=15
WEB_MAX_RESPONSE_BYTES=2000000

# ----- SECURITY -----------------------------------------------------------
# Off by default: mouse/keyboard control of the real desktop is the riskiest
# capability here. Each action also requires its own confirm=true on top of
# this being enabled.
SECURITY_COMPUTER_CONTROL_ENABLED=false
# Comma-separated list of directories file tools may read/write. Defaults to
# the project's own sandbox workspace; add your own (e.g. ~/Documents) to
# extend it. File tools refuse everything if this is left empty.
SECURITY_ALLOWED_FILESYSTEM_PATHS=./sandbox/workspace
SECURITY_CONFIRMATION_TIMEOUT_SECONDS=120
SECURITY_SANDBOX_TIMEOUT_SECONDS=30
SECURITY_MAX_FILE_READ_BYTES=500000
SECURITY_MAX_FILE_WRITE_BYTES=5000000
# Simple per-client-IP request rate limit (protects against a runaway loop
# or accidental hammering, not designed for a public multi-tenant deployment).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ----- MEMORY -------------------------------------------------------------
MEMORY_PRIVACY_MODE=false
# Provider used to compute memory embeddings; blank = use AI_DEFAULT_PROVIDER
MEMORY_EMBEDDING_PROVIDER=
# Model used to compute memory embeddings; blank = provider's chat model.
# Recommended for Ollama: a small dedicated embedding model, e.g. all-minilm
MEMORY_EMBEDDING_MODEL=
# Must match the chosen embedding model's output size (all-minilm=384,
# nomic-embed-text=768, OpenAI text-embedding-3-small=1536)
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_MAX_DISTANCE=0.6

# ----- AUTOMATION ---------------------------------------------------------
AUTOMATION_MAX_CONCURRENT_TASKS=5

# ----- LOGGING ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
